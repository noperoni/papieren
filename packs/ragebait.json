{
  "$schema": "./pack.schema.json",
  "papierenPack": 1,
  "id": "ragebait",
  "name": "Ragebait",
  "kind": "junk",
  "description": "Picks a fight for reach: provocations, outrage framing and us-against-them bait.",
  "version": 1,
  "threshold": 6,
  "tells": [
    { "w": 1, "on": "bio", "pattern": "\\b(?:politically incorrect|not politically correct|easily offended)\\b" },
    { "w": 2, "on": "shape", "measure": "caps", "min": 0.6 },
    { "w": 1, "on": "context", "is": "quote" },
    { "w": 2, "on": "account", "is": "everywhere" },
    { "w": 1, "on": "account", "is": "offences" },
    { "w": 2, "on": "account", "is": "hidden-before" }
  ],
  "languages": {
    "en": [
      { "w": 3, "on": "text", "phrase": "fight me" },
      { "w": 3, "on": "text", "phrase": "change my mind" },
      { "w": 3, "on": "text", "phrase": "come at me" },
      { "w": 3, "on": "text", "phrase": "i said what i said" },
      { "w": 3, "on": "text", "phrase": "stay mad" },
      { "w": 3, "on": "text", "pattern": "\\bcry (?:harder|about it|more)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bcope (?:harder|and seethe)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bnot ready for (?:this|that) conversation\\b" },
      { "w": 3, "on": "text", "pattern": "\\b(?:all )?(?:men|women) are (?:trash|garbage|useless|the problem)\\b" },
      { "w": 2, "on": "text", "pattern": "\\b(?:unpopular|controversial) (?:opinion|take)\\b" },
      { "w": 2, "on": "text", "phrase": "hot take" },
      { "w": 2, "on": "text", "phrase": "say it louder" },
      { "w": 2, "on": "text", "phrase": "for the people in the back" },
      { "w": 2, "on": "text", "phrase": "unfollow me" },
      { "w": 2, "on": "text", "phrase": "seethe" },
      { "w": 2, "on": "text", "phrase": "rent free" },
      { "w": 2, "on": "text", "phrase": "touch grass" },
      { "w": 2, "on": "text", "pattern": "\\bimagine (?:thinking|believing|defending|unironically)\\b" },
      { "w": 2, "on": "text", "phrase": "the audacity" },
      { "w": 2, "on": "text", "pattern": "\\bhow is this (?:legal|allowed|ok|okay|acceptable)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bshould be (?:illegal|banned|arrested|jailed|fired|ashamed)\\b" },
      { "w": 2, "on": "text", "phrase": "die on this hill" },
      { "w": 2, "on": "text", "pattern": "\\bnot (?:even )?(?:debatable|up for debate)\\b" },
      { "w": 2, "on": "text", "phrase": "pick a side" },
      { "w": 2, "on": "text", "phrase": "ok boomer" },
      { "w": 2, "on": "text", "pattern": "\\bi['’]?ll wait\\b" },
      { "w": 1, "on": "text", "pattern": "\\bi don['’]?t care what (?:anyone|anybody|people|you) (?:says?|thinks?)\\b" },
      { "w": 1, "on": "text", "pattern": "\\bname (?:one|a single)\\b" },
      { "w": 1, "on": "text", "pattern": "\\bend of (?:discussion|debate|story)\\b" },
      { "w": 1, "on": "text", "phrase": "full stop" },
      { "w": 1, "on": "text", "phrase": "if you disagree" },
      { "w": 1, "on": "text", "phrase": "nobody asked" },
      { "w": 1, "on": "text", "phrase": "skill issue" },
      { "w": 1, "on": "text", "phrase": "ratio" },
      { "w": 1, "on": "text", "phrase": "triggered" },
      { "w": 1, "on": "text", "pattern": "\\bsnowflakes?\\b" },
      { "w": 1, "on": "text", "phrase": "you people" },
      { "w": 1, "on": "text", "phrase": "these people" },
      { "w": 1, "on": "text", "phrase": "disgusting" },
      { "w": 1, "on": "text", "phrase": "pathetic" },
      { "w": 1, "on": "text", "phrase": "clown" },
      { "w": 1, "on": "text", "phrase": "🤡" }
    ]
  }
}
