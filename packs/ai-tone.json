{
  "$schema": "./pack.schema.json",
  "papierenPack": 1,
  "id": "ai-tone",
  "name": "AI-tone writing",
  "kind": "junk",
  "description": "Reads like unedited chatbot output: stock phrases, hollow hype, tidy emoji lists.",
  "version": 1,
  "threshold": 6,
  "tells": [
    { "w": 1, "on": "bio", "pattern": "\\b(?:ai|chatgpt|gpt|llm|prompt) (?:enthusiast|tools|automation|educator|creator|engineer|engineering)\\b" },
    { "w": 1, "on": "shape", "measure": "lines", "min": 3 },
    { "w": 1, "on": "shape", "measure": "emoji", "min": 4 },
    { "w": 1, "on": "shape", "measure": "hashtags", "min": 3 }
  ],
  "languages": {
    "en": [
      { "w": 4, "on": "text", "pattern": "\\bas an? (?:ai|large)(?: language)? model\\b" },
      { "w": 4, "on": "text", "pattern": "\\bas of my (?:last )?(?:knowledge|training) (?:update|cutoff|cut-off)\\b" },
      { "w": 4, "on": "text", "pattern": "\\bi (?:cannot|can['’]?t) (?:fulfill|assist with|help with) (?:this|that|your) request\\b" },
      { "w": 4, "on": "text", "phrase": "regenerate response" },
      { "w": 3, "on": "text", "pattern": "\\bin today['’]?s (?:fast-paced|digital|ever-changing|rapidly evolving|modern) (?:world|age|landscape|era)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bnavigat(?:e|es|ing) the (?:complexities|intricacies|nuances)\\b" },
      { "w": 3, "on": "text", "pattern": "\\blet['’]?s (?:dive|delve) (?:in|into|deeper)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bharness(?:ing)? the (?:power|potential) of\\b" },
      { "w": 3, "on": "text", "pattern": "\\bunlock(?:ing)? (?:your|my|the|its) (?:full )?(?:potential|power)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bembark(?:ing)? on (?:a|an|this|your|my) (?:new )?(?:journey|adventure|chapter)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bdelv(?:e|es|ed|ing)\\b" },
      { "w": 2, "on": "text", "phrase": "tapestry" },
      { "w": 2, "on": "text", "phrase": "testament to" },
      { "w": 2, "on": "text", "pattern": "\\b(?:ever-evolving|ever-changing|rapidly evolving) (?:landscape|world|field|space)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bit(?: is|['’]s) (?:important|worth|crucial) (?:to note|noting|to remember)\\b" },
      { "w": 2, "on": "text", "phrase": "in the realm of" },
      { "w": 2, "on": "text", "pattern": "\\b(?:crucial|pivotal|vital) role\\b" },
      { "w": 2, "on": "text", "phrase": "a myriad of" },
      { "w": 2, "on": "text", "pattern": "\\bunderscor(?:es|ing) the (?:importance|need|significance)\\b" },
      { "w": 2, "on": "text", "pattern": "\\b(?:serves as a|a stark) reminder\\b" },
      { "w": 2, "on": "text", "pattern": "\\bnot only\\b.{1,80}\\bbut also\\b" },
      { "w": 2, "on": "text", "pattern": "\\bwhether you['’]?re (?:a|an)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bin an (?:era|age|world) (?:of|where)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bfoster(?:ing)? (?:a sense of|innovation|collaboration|growth|connection)\\b" },
      { "w": 2, "on": "text", "phrase": "multifaceted" },
      { "w": 2, "on": "text", "pattern": "\\bkey takeaways?\\b" },
      { "w": 2, "on": "text", "phrase": "in conclusion" },
      { "w": 2, "on": "text", "phrase": "great question" },
      { "w": 2, "on": "text", "pattern": "\\bi hope this (?:helps|clarifies)\\b" },
      { "w": 2, "on": "text", "pattern": "—[^—]*—" },
      { "w": 1, "on": "text", "phrase": "—" },
      { "w": 1, "on": "text", "pattern": "\\b(?:isn['’]?t|is not|it['’]?s not) just\\b" },
      { "w": 1, "on": "text", "pattern": "\\bhere['’]?s (?:why|how|the thing)\\b" },
      { "w": 1, "on": "text", "pattern": "\\bgame[- ]?changer\\b" },
      { "w": 1, "on": "text", "pattern": "\\bseamless(?:ly)?\\b" },
      { "w": 1, "on": "text", "pattern": "\\bshowcas(?:es|ing)\\b" },
      { "w": 1, "on": "text", "pattern": "\\brevolutioni[sz](?:e|es|ed|ing)\\b" },
      { "w": 1, "on": "text", "pattern": "\\bresonat(?:e|es|ing) (?:with|deeply)\\b" },
      { "w": 1, "on": "text", "phrase": "transformative" },
      { "w": 1, "on": "text", "phrase": "intricacies" },
      { "w": 1, "on": "text", "phrase": "paramount" },
      { "w": 1, "on": "text", "phrase": "moreover" },
      { "w": 1, "on": "text", "phrase": "furthermore" },
      { "w": 1, "on": "text", "phrase": "additionally" },
      { "w": 1, "on": "text", "phrase": "in summary" },
      { "w": 1, "on": "text", "phrase": "let that sink in" },
      { "w": 1, "on": "text", "phrase": "read that again" },
      { "w": 1, "on": "text", "phrase": "🚀" },
      { "w": 1, "on": "text", "phrase": "💡" },
      { "w": 1, "on": "text", "phrase": "🔑" }
    ]
  }
}
