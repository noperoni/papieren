{
  "$schema": "./pack.schema.json",
  "papierenPack": 1,
  "id": "engagement-bait",
  "name": "Engagement bait",
  "kind": "junk",
  "description": "Asks for likes, reposts, follows or replies instead of saying something.",
  "version": 1,
  "threshold": 6,
  "tells": [
    { "w": 1, "on": "name", "pattern": "\\b(?:ifb|f4f|follow ?back)\\b" },
    { "w": 2, "on": "bio", "pattern": "\\b(?:ifb|f4f|l4l|follow ?back|follow for follow|like for like)\\b" },
    { "w": 1, "on": "bio", "pattern": "\\bdm (?:for|4) (?:promo|shout ?outs?)\\b" },
    { "w": 1, "on": "shape", "measure": "emoji", "min": 5 },
    { "w": 1, "on": "shape", "measure": "hashtags", "min": 5 },
    { "w": -1, "on": "context", "is": "reply" }
  ],
  "languages": {
    "en": [
      { "w": 4, "on": "text", "pattern": "\\b(?:rt|retweet|repost)(?: this)? if you\\b" },
      { "w": 4, "on": "text", "pattern": "\\b(?:like|share) this if you\\b" },
      { "w": 4, "on": "text", "pattern": "(?:^|[.!?\\n] *)(?:like|share) if you\\b" },
      { "w": 4, "on": "text", "pattern": "\\b(?:1|one|each|every) (?:like|rt|retweet|repost|follow|share) ?=" },
      { "w": 4, "on": "text", "pattern": "\\bfor every (?:like|rt|retweet|repost|follow|share)\\b" },
      { "w": 4, "on": "text", "phrase": "follow for more" },
      { "w": 4, "on": "text", "phrase": "follow me for more" },
      { "w": 4, "on": "text", "phrase": "follow us for more" },
      { "w": 4, "on": "text", "phrase": "follow for follow" },
      { "w": 4, "on": "text", "phrase": "i follow back" },
      { "w": 4, "on": "text", "phrase": "follow train" },
      { "w": 4, "on": "text", "pattern": "\\bfollow (?:everyone|everybody|all) (?:who|that)\\b" },
      { "w": 4, "on": "text", "pattern": "\\b(?:smash|hit) (?:that|the) (?:like|follow|repost|retweet)\\b" },
      { "w": 4, "on": "text", "pattern": "\\b(?:make|help) (?:this|it) go viral\\b" },
      { "w": 4, "on": "text", "pattern": "\\bcan (?:i|we) get (?:this to )?\\d[\\d,.k]* (?:likes|retweets|rts|reposts|followers)\\b" },
      { "w": 4, "on": "text", "pattern": "\\b(?:type|comment) (?:yes|amen)\\b" },
      { "w": 4, "on": "text", "phrase": "say amen" },
      { "w": 3, "on": "text", "pattern": "\\bonly \\d+% (?:of people )?(?:can|will|get|know)\\b" },
      { "w": 3, "on": "text", "pattern": "\\b(?:like|rt|retweet|repost|follow|share),? (?:and|&|\\+) (?:like|rt|retweet|repost|follow|share|subscribe|comment)\\b" },
      { "w": 3, "on": "text", "pattern": "\\b(?:retweet|repost|rt) (?:this|to|so)\\b" },
      { "w": 3, "on": "text", "phrase": "tag a friend" },
      { "w": 3, "on": "text", "phrase": "tag someone" },
      { "w": 3, "on": "text", "pattern": "\\b(?:don['’]?t|do not|stop) scroll" },
      { "w": 3, "on": "text", "pattern": "\\bturn on (?:post )?notifications\\b" },
      { "w": 3, "on": "text", "pattern": "\\b(?:check|see|read) (?:my )?pinned\\b" },
      { "w": 3, "on": "text", "pattern": "\\bcomment [\"“'‘]?[a-z0-9]+[\"”'’]? (?:and|for|to get)\\b" },
      { "w": 3, "on": "text", "pattern": "\\band i['’]?ll (?:dm|send) (?:you|it)\\b" },
      { "w": 3, "on": "text", "pattern": "\\bdrop an? \\S+ (?:if|below)\\b" },
      { "w": 3, "on": "text", "phrase": "agree or disagree" },
      { "w": 3, "on": "text", "pattern": "\\bonly (?:real|true) fans\\b" },
      { "w": 3, "on": "text", "pattern": "\\byou['’]?re old if\\b" },
      { "w": 3, "on": "text", "phrase": "hands up if" },
      { "w": 3, "on": "text", "pattern": "\\bbet you can['’]?t\\b" },
      { "w": 2, "on": "text", "pattern": "\\bmust (?:be )?follow" },
      { "w": 2, "on": "text", "phrase": "giveaway" },
      { "w": 2, "on": "text", "phrase": "comment below" },
      { "w": 2, "on": "text", "phrase": "drop a comment" },
      { "w": 2, "on": "text", "phrase": "let me know in the comments" },
      { "w": 2, "on": "text", "phrase": "who agrees" },
      { "w": 2, "on": "text", "phrase": "yes or no" },
      { "w": 2, "on": "text", "phrase": "where are my" },
      { "w": 2, "on": "text", "phrase": "raise your hand" },
      { "w": 2, "on": "text", "pattern": "\\b(?:pick|choose) one\\b" },
      { "w": 2, "on": "text", "phrase": "rate this" },
      { "w": 2, "on": "text", "phrase": "bookmark this" },
      { "w": 2, "on": "text", "pattern": "\\bcan you (?:spot|find|solve|guess|name)\\b" },
      { "w": 2, "on": "text", "pattern": "\\bmutuals?\\b" },
      { "w": 2, "on": "text", "pattern": "\\b(?:gain|get more) followers\\b" },
      { "w": 2, "on": "text", "pattern": "\\bgrow (?:together|with me)\\b" },
      { "w": 1, "on": "text", "pattern": "\\b(?:thoughts|agree|am i wrong|what do you think) ?\\?" },
      { "w": 1, "on": "text", "pattern": "\\b(?:1|0) ?(?:-|to) ?10\\b" },
      { "w": 1, "on": "text", "phrase": "who else" },
      { "w": 1, "on": "text", "phrase": "be honest" },
      { "w": 1, "on": "text", "phrase": "to win" },
      { "w": 1, "on": "text", "phrase": "link in bio" }
    ]
  }
}
